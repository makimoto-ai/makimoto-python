[general]
# Enforces https://www.conventionalcommits.org/ on the commit title:
# type(optional-scope): description
contrib=contrib-title-conventional-commits

# Conventional Commits itself doesn't require a body, a one-line title-only
# commit ("fix: correct README typo") is normal and shouldn't be flagged.
ignore=body-is-missing

[contrib-title-conventional-commits]
types=feat,fix,docs,style,refactor,perf,test,build,ci,chore,revert
